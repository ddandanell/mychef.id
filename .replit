modules = ["nodejs-20", "web", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 35545
externalPort = 8081

[[ports]]
localPort = 35723
externalPort = 5000

[[ports]]
localPort = 36015
externalPort = 8000

[[ports]]
localPort = 36807
externalPort = 3000

[[ports]]
localPort = 37233
externalPort = 8080

[[ports]]
localPort = 37767
externalPort = 6800

[[ports]]
localPort = 38141
externalPort = 3003

[[ports]]
localPort = 39123
externalPort = 4200

[[ports]]
localPort = 39921
externalPort = 8008

[[ports]]
localPort = 41107
externalPort = 6000

[[ports]]
localPort = 41285
externalPort = 5173

[[ports]]
localPort = 42875
externalPort = 3002

[[ports]]
localPort = 43047
externalPort = 3001

[[ports]]
localPort = 44581
externalPort = 8099

[[ports]]
localPort = 45349
externalPort = 9000

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000
